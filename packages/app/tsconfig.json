{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "customConditions": ["source"],
    "baseUrl": ".",
    "paths": {
      "@sdk/*": ["../sdk/src/*"]
    },
    "strict": true,
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/app.tsbuildinfo",
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.cache/types",
    "rootDir": "src",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "references": [{ "path": "../sdk/tsconfig.reference.json" }]
}
